<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_approval_graph" model="ir.ui.view">
        <field name="name">event.event.approval.graph</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <graph string="Events by Approval Status" type="bar">
                <field name="approval_state"/>
            </graph>
        </field>
    </record>

    <record id="view_event_approval_pivot" model="ir.ui.view">
        <field name="name">event.event.approval.pivot</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <pivot string="Events by Approval Status">
                <field name="approval_state" type="row"/>
                <field name="attendance_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_event_approval_overview" model="ir.actions.act_window">
        <field name="name">Approval Overview</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">graph,pivot,list,form</field>
    </record>

    <menuitem id="menu_event_approval_overview"
              name="Approval Overview"
              parent="event.menu_reporting_events"
              action="action_event_approval_overview"
              sequence="5"
              groups="eventflow_management.group_eventflow_manager"/>

    <record id="view_registration_attendance_pivot" model="ir.ui.view">
        <field name="name">event.registration.attendance.pivot</field>
        <field name="model">event.registration</field>
        <field name="arch" type="xml">
            <pivot string="Attendance by Event">
                <field name="event_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_registration_attendance_graph" model="ir.ui.view">
        <field name="name">event.registration.attendance.graph</field>
        <field name="model">event.registration</field>
        <field name="arch" type="xml">
            <graph string="Attendance by Event" type="bar">
                <field name="event_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_event_attendance_report" model="ir.actions.act_window">
        <field name="name">Attendance Report</field>
        <field name="res_model">event.registration</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', 'in', ['open', 'done'])]</field>
    </record>

    <menuitem id="menu_event_attendance_report"
              name="Attendance Report"
              parent="event.menu_reporting_events"
              action="action_event_attendance_report"
              sequence="10"
              groups="eventflow_management.group_eventflow_manager"/>

    <record id="view_event_dashboard_kanban" model="ir.ui.view">
        <field name="name">event.event.dashboard.kanban</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <kanban create="false" records_draggable="false">
                <field name="attendance_percent"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5 d-block"/>
                        <field name="date_begin" class="text-muted small d-block mb-3"/>
                        <div class="d-flex justify-content-between text-center">
                            <div>
                                <div class="fs-4 fw-bold"><field name="seats_taken"/></div>
                                <div class="text-muted small">Participants</div>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold"><field name="seats_used"/></div>
                                <div class="text-muted small">Attended</div>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold">
                                    <t t-esc="Math.round(record.attendance_percent.raw_value)"/>%
                                </div>
                                <div class="text-muted small">Attendance</div>
                            </div>
                        </div>
                        <div class="progress mt-3" style="height: 6px;">
                            <div class="progress-bar bg-success"
                                 t-attf-style="width: #{record.attendance_percent.raw_value}%;"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_event_dashboard" model="ir.actions.act_window">
        <field name="name">Event Dashboard</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'group_by': 'approval_state', 'search_default_upcoming': 1}</field>
    </record>

    <menuitem id="menu_event_dashboard"
              name="Event Dashboard"
              parent="event.menu_event_event"
              action="action_event_dashboard"
              sequence="1"
              groups="eventflow_management.group_eventflow_staff"/>

    <record id="view_event_revenue_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.event.revenue.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Revenue by Event">
                <field name="event_id" type="row"/>
                <field name="price_subtotal" type="measure"/>
                <field name="untaxed_amount_invoiced" type="measure"/>
                <field name="untaxed_amount_to_invoice" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_event_revenue_graph" model="ir.ui.view">
        <field name="name">sale.order.line.event.revenue.graph</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <graph string="Revenue by Event" type="bar">
                <field name="event_id"/>
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_event_revenue_report" model="ir.actions.act_window">
        <field name="name">Revenue Report</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('event_id', '!=', False), ('state', '=', 'sale')]</field>
    </record>

    <record id="action_event_revenue_report_pivot" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_event_revenue_pivot"/>
        <field name="act_window_id" ref="action_event_revenue_report"/>
    </record>

    <record id="action_event_revenue_report_graph" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_event_revenue_graph"/>
        <field name="act_window_id" ref="action_event_revenue_report"/>
    </record>

    <menuitem id="menu_event_revenue_report"
              name="Revenue Report"
              parent="event.menu_reporting_events"
              action="action_event_revenue_report"
              sequence="15"
              groups="eventflow_management.group_eventflow_manager"/>
</odoo>