<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_registration_form_inherit_checkin" model="ir.ui.view">
        <field name="name">event.registration.form.inherit.checkin</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_closed']" position="after">
                <field name="checked_in_by"/>
            </xpath>
        </field>
    </record>
</odoo>