<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_inherit_approval" model="ir.ui.view">
        <field name="name">event.event.form.inherit.approval</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit" string="Submit for Approval" type="object"
                        class="btn-primary"
                        invisible="approval_state != 'draft'"/>
                <button name="action_approve" string="Approve" type="object"
                        class="btn-primary"
                        groups="eventflow_management.group_eventflow_manager"
                        invisible="approval_state != 'submitted'"/>
                <button name="action_reject" string="Reject" type="object"
                        class="btn-danger"
                        groups="eventflow_management.group_eventflow_manager"
                        invisible="approval_state != 'submitted'"/>
                <button name="action_reset_draft" string="Reset to Draft" type="object"
                        groups="eventflow_management.group_eventflow_staff"
                        invisible="approval_state != 'rejected'"/>
                <button name="action_reset_draft" string="Reset to Draft" type="object"
                        groups="eventflow_management.group_eventflow_manager"
                        invisible="approval_state != 'approved'"/>
                <button name="action_cancel_event" string="Cancel Event" type="object"
                        groups="eventflow_management.group_eventflow_manager"
                        confirm="Cancel this event and all of its pending registrations?"
                        invisible="approval_state != 'approved'"/>
                <field name="approval_state" widget="statusbar"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group invisible="approval_state not in ('submitted', 'rejected')">
                    <field name="rejection_reason"/>
                </group>
                <group invisible="approval_state not in ('approved', 'cancelled')"
                       groups="eventflow_management.group_eventflow_manager">
                    <field name="cancel_reason" readonly="approval_state == 'cancelled'"/>
                </group>
                <group string="Attendance" invisible="approval_state != 'approved'">
                    <field name="seats_taken"/>
                    <field name="seats_used"/>
                    <field name="attendance_rate" widget="percentage"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='date_begin']" position="attributes">
                <attribute name="readonly">approval_state == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='seats_limited']" position="attributes">
                <attribute name="readonly">approval_state == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='seats_max']" position="attributes">
                <attribute name="readonly">approval_state == 'approved'</attribute>
            </xpath>
        </field>
    </record>
        <record id="view_event_search_inherit_approval" model="ir.ui.view">
        <field name="name">event.event.search.inherit.approval</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myevents']" position="before">
                <filter string="Pending Approval" name="filter_pending_approval"
                        domain="[('approval_state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('approval_state', '=', 'approved')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('approval_state', '=', 'cancelled')]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='stage_id']" position="after">
                <filter string="Approval Status" name="group_approval_state"
                        context="{'group_by': 'approval_state'}"/>
            </xpath>
        </field>
    </record>
    <record id="view_event_list_inherit_approval" model="ir.ui.view">
        <field name="name">event.event.list.inherit.approval</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-info="approval_state == 'submitted'"
                       decoration-danger="approval_state == 'rejected'"
                       decoration-warning="approval_state == 'cancelled'"/>
                <field name="seats_taken" string="Participants"/>
                <field name="seats_used" string="Attended"/>
                <field name="attendance_rate" widget="percentage" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>