<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_event_staff_visible" model="ir.rule">
        <field name="name">EventFlow: staff sees approved, created or submitted events</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="domain_force">['|', '|', ('approval_state', 'in', ['approved', 'cancelled']), ('submitted_by', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('eventflow_management.group_eventflow_staff'))]"/>
    </record>

    <record id="rule_event_manager_all" model="ir.rule">
        <field name="name">EventFlow: managers see all events</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('eventflow_management.group_eventflow_manager'))]"/>
    </record>
        <record id="rule_registration_staff_visible" model="ir.rule">
        <field name="name">EventFlow: staff sees registrations of visible events</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="domain_force">['|', '|', ('event_id.approval_state', 'in', ['approved', 'cancelled']), ('event_id.submitted_by', '=', user.id), ('event_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('eventflow_management.group_eventflow_staff'))]"/>
    </record>

    <record id="rule_registration_manager_all" model="ir.rule">
        <field name="name">EventFlow: managers see all registrations</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('eventflow_management.group_eventflow_manager'))]"/>
    </record>
</odoo>