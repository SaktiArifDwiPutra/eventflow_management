<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_eventflow_staff" model="res.groups">
        <field name="name">EventFlow: Event Staff</field>
        <field name="implied_ids" eval="[(4, ref('event.group_event_user'))]"/>
    </record>

    <record id="group_eventflow_manager" model="res.groups">
        <field name="name">EventFlow: Event Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_eventflow_staff'))]"/>
    </record>

    <record id="group_eventflow_admin" model="res.groups">
        <field name="name">EventFlow: Event Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_eventflow_manager')), (4, ref('event.group_event_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>